{
  "name": "payx-node",
  "version": "1.0.2",
  "description": "The official Node.js SDK for PayX",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "payx",
    "payments",
    "ghana",
    "mobile-money"
  ],
  "author": "PayX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roger9696/payx-node.git"
  },
  "bugs": {
    "url": "https://github.com/roger9696/payx-node/issues"
  },
  "homepage": "https://github.com/roger9696/payx-node#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
